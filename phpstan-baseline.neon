parameters:
	ignoreErrors:
		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 5
			path: src/Uri_Template.php

		-
			message: '#^Method Guzzle_Http\\Uri_Template\\Uri_Template\:\:is_assoc\(\) has parameter \$array with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Uri_Template.php

		-
			message: '#^Parameter \#1 \$matches of static method Guzzle_Http\\Uri_Template\\Uri_Template\:\:expand_match\(\) expects array\<string\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: src/Uri_Template.php
